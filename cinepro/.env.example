# ─────────────────────────────────────────────────────────────
#  CinePro Core — minimal configuration
#  Only TMDB_API_KEY is required. Everything else has sane
#  defaults; uncomment a line only if you actually need it.
# ─────────────────────────────────────────────────────────────

# REQUIRED — your TMDB API key (v3 auth). Get one (free) at:
#   https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Where the server listens.
#   HOST=localhost  -> only this machine can reach it (dev)
#   HOST=0.0.0.0    -> reachable on your LAN / from a container (hosting)
HOST=localhost
PORT=3000

# Which website origins may call this API from a browser.
#   "*"                     -> allow any site (simplest; fine for personal use)
#   "https://your.site"     -> lock it to just your front-end
CORS_ORIGIN="*"

# ─────────────────────────────────────────────────────────────
#  Optional — you almost certainly don't need these.
#  Defaults: in-memory cache (no Redis), Stremio/MCP off,
#  NODE_ENV=development. Uncomment to change.
# ─────────────────────────────────────────────────────────────
# NODE_ENV=production
# CACHE_TYPE=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
